---
import { uiConfig } from "../ui-config";

const config = uiConfig.comments;
const configured =
	config.provider === "twikoo"
		? Boolean(config.twikooEnvId)
		: config.provider === "giscus" &&
			Boolean(config.repo && config.repoId && config.categoryId);
---
{config.enable && configured && <section id="comments" class="card-base comments-box" data-comments={JSON.stringify(config)}><h2 class="m3-widget-title">评论</h2><button type="button" data-load-comments>加载评论</button><div class="giscus"></div><div class="twikoo"></div><p data-comment-status aria-live="polite"></p></section>}
<script>
function setupComments() {
  document.querySelectorAll<HTMLElement>(".comments-box").forEach(container => {
    const button = container.querySelector<HTMLButtonElement>("[data-load-comments]");
    if (!button || button.dataset.ready) return;
    button.dataset.ready = "true";
    button.onclick = async () => {
      const config = JSON.parse(container.dataset.comments || "{}");
      if (config.provider === "twikoo") {
        button.disabled = true;
        const status = container.querySelector<HTMLElement>("[data-comment-status]");
        try {
          const source = new URL(config.twikooScriptUrl);
          if (source.protocol !== "https:" || source.username || source.password) throw new Error("Invalid comments script");
          const target = container.querySelector<HTMLElement>(".twikoo");
          if (!target) return;
          target.id = `comments-${Math.random().toString(36).slice(2)}`;
          const api = window as typeof window & { twikoo?: { init(options: { envId: string; el: string; lang: string; path: string }): Promise<void> } };
          if (!api.twikoo) await new Promise<void>((resolve, reject) => {
            const script = document.createElement("script"); script.src = source.href; script.async = true;
            script.onload = () => resolve(); script.onerror = () => { script.remove(); reject(new Error("Comments unavailable")); };
            document.head.append(script);
          });
          if (!api.twikoo) throw new Error("Comments unavailable");
          await api.twikoo.init({ envId: config.twikooEnvId, el: `#${target.id}`, lang: document.documentElement.lang, path: location.pathname });
          button.remove();
        } catch { if (status) status.textContent = "暂时无法加载评论，请稍后重试。"; }
        finally { button.disabled = false; }
        return;
      }
      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js"; script.async = true; script.crossOrigin = "anonymous";
      const data = { repo: config.repo, "repo-id": config.repoId, category: config.category, "category-id": config.categoryId, mapping: "pathname", strict: "1", "reactions-enabled": "1", "emit-metadata": "0", "input-position": "top", theme: document.documentElement.classList.contains("dark") ? "dark" : "light", lang: "zh-CN", loading: "lazy" };
      for (const [name, value] of Object.entries(data)) script.setAttribute(`data-${name}`, String(value));
      container.querySelector(".giscus")?.append(script);
      button.remove();
    };
  });
}
setupComments();
if (window.swup) window.swup.hooks.on("page:view", setupComments);
else document.addEventListener("swup:enable", () => window.swup.hooks.on("page:view", setupComments), { once: true });
</script>
<style>.comments-box { padding: 1.5rem; margin-bottom: 1rem; } button { padding: .7rem 1rem; border-radius: 99px; background: var(--btn-regular-bg); color: var(--primary); font-size: .85rem; }</style>
