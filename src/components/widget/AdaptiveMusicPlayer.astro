---
import extras from "../../data/site-extras.json";
import { uiConfig } from "../../ui-config";
import {
	buildMetingUrl,
	mergeMusicTracks,
	normalizeMusicTracks,
} from "../../utils/music-sources";

const config = uiConfig.music;
const tracks =
	config.provider === "meting"
		? []
		: config.provider === "mixed"
			? mergeMusicTracks(
					normalizeMusicTracks(extras.music),
					normalizeMusicTracks(config.tracks, "custom"),
				)
			: normalizeMusicTracks(
					config.provider === "custom" ? config.tracks : extras.music,
				);
const remote = ["meting", "mixed"].includes(config.provider)
	? buildMetingUrl(config.meting)
	: undefined;
---
{config.enable && (tracks.length > 0 || remote) && <section class="card-base m3-widget adaptive-music" data-tracks={JSON.stringify(tracks)} data-remote={remote} data-preload={config.meting.preload} data-volume={config.defaultVolume} data-mode={config.defaultMode} aria-label="音乐播放器">
  <h2 class="m3-widget-title">音乐播放器</h2><p data-track-title>{tracks[0]?.title || "点击加载音乐"}</p><small data-track-artist>{tracks[0]?.artist || ""}</small><audio preload="none"></audio>
  <div class="music-controls"><button type="button" data-action="previous" aria-label="上一曲">⏮</button><button type="button" data-action="play" aria-label="播放">▶</button><button type="button" data-action="next" aria-label="下一曲">⏭</button><button type="button" data-action="mode" aria-label="切换播放模式">↪</button></div>
  <label class="music-seek"><span data-time>0:00</span><input type="range" data-seek min="0" max="100" value="0" aria-label="播放进度"/><span data-duration>0:00</span></label>
  <label class="music-volume">音量<input type="range" data-volume min="0" max="1" step="0.05" value={config.defaultVolume} aria-label="音量"/></label>
  {remote && <button type="button" data-action="remote" class="remote-button">加载更多音乐</button>}<p data-status aria-live="polite"></p>
  <details><summary>播放列表</summary><ol data-playlist>{tracks.map((track, index) => <li><button type="button" data-track-index={index}>{track.title}<small>{track.artist}</small></button></li>)}</ol></details>
</section>}
<script>
import { fetchMetingTracks, mergeMusicTracks, normalizeMusicTracks } from "../../utils/music-sources";
for (const player of document.querySelectorAll<HTMLElement>(".adaptive-music")) {
  const audio = player.querySelector("audio"); if (!audio) continue;
  let tracks = normalizeMusicTracks(JSON.parse(player.dataset.tracks || "[]"));
  let index = 0; let mode = ["sequence", "repeat-one", "shuffle"].indexOf(player.dataset.mode || "sequence"); if (mode < 0) mode = 0;
  let remoteLoaded = false; let remoteTask: Promise<void> | undefined;
  const play = player.querySelector<HTMLButtonElement>("[data-action='play']");
  const status = player.querySelector<HTMLElement>("[data-status]");
  const format = (time: number) => `${Math.floor(time / 60)}:${String(Math.floor(time % 60)).padStart(2, "0")}`;
  const setStatus = (message: string) => { if (status) status.textContent = message; };
  function playlist() {
    const list = player.querySelector("[data-playlist]"); if (!list) return; list.replaceChildren();
    tracks.forEach((track, position) => { const item = document.createElement("li"); const button = document.createElement("button"); button.type = "button"; button.dataset.trackIndex = String(position); button.textContent = track.title; const artist = document.createElement("small"); artist.textContent = track.artist || ""; button.append(artist); item.append(button); list.append(item); });
  }
  async function loadRemote() {
    if (!player.dataset.remote || remoteLoaded) return;
    if (remoteTask) return remoteTask;
    setStatus("正在加载歌单…");
    remoteTask = (async () => { try { const remote = await fetchMetingTracks(player.dataset.remote!); tracks = mergeMusicTracks(tracks, remote); remoteLoaded = true; playlist(); setStatus(tracks.length ? "歌单已更新。" : "歌单暂时没有可播放的曲目。"); } catch { setStatus(tracks.length ? "远程歌单暂不可用，可继续播放本地音乐。" : "暂时无法加载音乐，请稍后重试。"); } finally { remoteTask = undefined; } })();
    return remoteTask;
  }
  function select(position: number, start = true) {
    if (!audio || !tracks.length) return;
    index = (position + tracks.length) % tracks.length; const track = tracks[index]; audio.src = track.source;
    const title = player.querySelector("[data-track-title]"); if (title) title.textContent = track.title;
    const artist = player.querySelector("[data-track-artist]"); if (artist) artist.textContent = track.artist || "";
    if (start) audio.play().catch(() => setStatus("音乐已准备好，请再次点击播放。"));
  }
  let savedVolume: string | null = null; try { savedVolume = localStorage.getItem("music-volume"); } catch { /* Storage can be disabled. */ }
  const volume = Number(savedVolume ?? player.dataset.volume); audio.volume = Number.isFinite(volume) ? Math.min(1, Math.max(0, volume)) : .7;
  const volumeInput = player.querySelector<HTMLInputElement>("[data-volume]"); if (volumeInput) volumeInput.value = String(audio.volume);
  player.addEventListener("click", async event => {
    const button = (event.target as Element).closest<HTMLButtonElement>("button"); if (!button) return;
    if (button.dataset.trackIndex !== undefined) { select(Number(button.dataset.trackIndex)); return; }
    const action = button.dataset.action;
    if (action === "remote") { await loadRemote(); return; }
    if (action === "mode") { mode = (mode + 1) % 3; button.title = ["顺序播放", "单曲循环", "随机播放"][mode]; button.textContent = ["↪", "↻", "⤨"][mode]; return; }
    if (!tracks.length) await loadRemote();
    if (!tracks.length) return;
    if (action === "play") { if (!audio.src) select(index); else if (audio.paused) audio.play().catch(() => setStatus("暂时无法播放，请重试。")); else audio.pause(); if (!remoteLoaded) void loadRemote(); }
    if (action === "previous") select(index - 1);
    if (action === "next") select(mode === 2 ? Math.floor(Math.random() * tracks.length) : index + 1);
  });
  audio.addEventListener("play", () => { if (play) { play.textContent = "Ⅱ"; play.setAttribute("aria-label", "暂停"); } });
  audio.addEventListener("pause", () => { if (play) { play.textContent = "▶"; play.setAttribute("aria-label", "播放"); } });
  audio.addEventListener("ended", () => select(mode === 1 ? index : mode === 2 ? Math.floor(Math.random() * tracks.length) : index + 1));
  audio.addEventListener("timeupdate", () => { const time = player.querySelector("[data-time]"); const duration = player.querySelector("[data-duration]"); const seek = player.querySelector<HTMLInputElement>("[data-seek]"); if (time) time.textContent = format(audio.currentTime); if (duration) duration.textContent = format(audio.duration || 0); if (seek) seek.value = String(audio.duration ? audio.currentTime / audio.duration * 100 : 0); });
  player.querySelector<HTMLInputElement>("[data-seek]")?.addEventListener("input", event => { if (Number.isFinite(audio.duration)) audio.currentTime = Number((event.target as HTMLInputElement).value) / 100 * audio.duration; });
  volumeInput?.addEventListener("input", event => { audio.volume = Number((event.target as HTMLInputElement).value); try { localStorage.setItem("music-volume", String(audio.volume)); } catch { /* Keep session volume working. */ } });
  audio.addEventListener("error", () => setStatus("这首音乐暂时无法播放，可以试试下一首。"));
  if (player.dataset.preload === "metadata" && player.dataset.remote) { const observer = new IntersectionObserver(entries => { if (entries.some(entry => entry.isIntersecting)) { observer.disconnect(); void loadRemote(); } }); observer.observe(player); }
}
</script>
<style>
  [data-track-title] { color: var(--mc-on-surface); font-weight: 600; font-size: .95rem; } small { display: block; font-size: .75rem; color: var(--mc-on-surface-variant); }
  .music-controls { display: flex; gap: .5rem; margin: 1rem 0; } .music-controls button { width: 2.5rem; height: 2.5rem; background: var(--btn-regular-bg); color: var(--primary); border-radius: 50%; }
  .music-controls [data-action='play'] { background: var(--primary); color: var(--mc-on-primary); }
  .music-seek, .music-volume { display: flex; align-items: center; gap: .5rem; margin-bottom: .8rem; font-size: .7rem; } input[type='range'] { min-width: 0; flex: 1; accent-color: var(--primary); }
  .remote-button { border-radius: 99px; color: var(--primary); background: var(--btn-regular-bg); padding: .4rem .7rem; font-size: .75rem; }
  [data-status] { color: var(--mc-on-surface-variant); font-size: .75rem; line-height: 1.5; margin-top: .5rem; } summary { cursor: pointer; font-size: .8rem; color: var(--primary); } li button { text-align: left; width: 100%; padding: .5rem; font-size: .8rem; }
</style>
