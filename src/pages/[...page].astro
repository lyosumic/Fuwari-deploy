---
import type { GetStaticPaths } from "astro";
import CollectionHeader from "../components/CollectionHeader.astro";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	if (!allBlogPosts.length) {
		return [
			{
				params: { page: undefined },
				props: {
					page: {
						data: [],
						start: 0,
						end: 0,
						total: 0,
						size: PAGE_SIZE,
						currentPage: 1,
						lastPage: 1,
						url: {
							current: url("/"),
							prev: undefined,
							next: undefined,
							first: undefined,
							last: undefined,
						},
					},
				},
			},
		];
	}
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
---

<MainGridLayout>
    {page.currentPage === 1 && <CollectionHeader title="记录，思考，创造。" eyebrow="LYOSUMIC'S JOURNAL" description="一些日常的思考，一些学习的痕迹，还有把想法变成代码的过程。欢迎来到我的小小空间。" icon="material-symbols:edit-note-rounded" count={page.total} unit="篇文章">
        <a class="link text-[var(--primary)] font-medium" href={url("/notes/")}>翻阅笔记 ↗</a>
        <a class="link text-[var(--primary)] font-medium" href={url("/projects/")}>探索项目 ↗</a>
    </CollectionHeader>}
    <PostPage page={page}></PostPage>
    {page.lastPage > 1 && <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>}
</MainGridLayout>
