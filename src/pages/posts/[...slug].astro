---
import PostArticle from "../../components/PostArticle.astro";
import { getSortedPosts } from "../../utils/content-utils";
import { cleanPostPath } from "../../utils/post-routes";
export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.flatMap((entry) => {
		const slugs = new Set([entry.slug]);
		if (entry.data.alias?.trim())
			slugs.add(cleanPostPath(entry.data.alias.replace(/^\/?posts\//, "")));
		if (entry.data.routeUrl?.startsWith("/posts/"))
			slugs.add(entry.data.routeUrl.slice(7, -1));
		return [...slugs].map((slug) => ({ params: { slug }, props: { entry } }));
	});
}
const { entry } = Astro.props;
---
<PostArticle entry={entry} />
